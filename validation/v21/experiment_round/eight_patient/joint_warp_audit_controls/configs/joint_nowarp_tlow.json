{
  "name": "joint_nowarp_tlow",
  "description": "Audit control: same joint graph and terminal tlow, omega_warp=1e6",
  "transform": {
    "genes_file": "validation/v21/experiment_round/eight_patient/feature_selection/top_250.json",
    "patient_gene_center": false
  },
  "fit": {
    "patient_key": "patient",
    "pseudotime_key": "s_local",
    "n_landmarks": 100,
    "consensus_resolution": 100,
    "landmark_method": "fixed",
    "locality_radius": 0.1,
    "beta": 1.0,
    "mode": "open",
    "n_min": 5,
    "epsilon": 1e-06,
    "kappa_i": 3.0,
    "kappa_d": 3.0,
    "calibration_quantile": 0.9,
    "calibration_band": 0.25,
    "max_iter": 200,
    "tol": 1e-06,
    "patience": 3,
    "d_min": 0.001,
    "chunk_size": 1024,
    "backend": "numba",
    "precision_mode": "unit",
    "warp": "on",
    "omega_warp": 1000000.0,
    "lambda_terminal_gap": 0.5
  }
}

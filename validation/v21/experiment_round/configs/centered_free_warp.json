    "mode": "open",
    "n_min": 5,
    "epsilon": 1e-6,
    "kappa_i": 3.0,
    "kappa_d": 0.0,
    "calibration_quantile": 0.9,
    "calibration_band": 0.25,
    "max_iter": 200,
    "tol": 1e-6,
    "patience": 3,
    "d_min": 1e-3,
    "chunk_size": 1024,
    "backend": "numba"
  }
}
